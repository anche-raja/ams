  <profiles>
    <!--
      What a build on a modern JDK needs and a Java 8 build must not see.

      The application is Java 8. A JDK 8 javac compiles it with -source/-target 1.8 and the JVM runs
      the tests with no module flags. On JDK 9 and later two things change. The compiler is told
      "release 8", so it compiles against the Java 8 class library - with plain -source/-target it
      would accept a Java 9+ API and the call would fail only at runtime on Java 8. And the pinned
      Mockito bundles a cglib that predates the module system and defines its proxies through
      ClassLoader.defineClass reflectively, so the test JVM has java.lang opened to it - a flag a
      Java 8 JVM rejects at startup, which is why it lives here rather than in the main Surefire
      configuration. Neither setting changes what is packaged: the class files are version 52 either
      way.
    -->
    <profile>
      <id>jdk9plus</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>8</maven.compiler.release>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>--add-opens java.base/java.lang=ALL-UNNAMED</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Legacy leftover from an earlier application server; retained but never activated by CI. -->
    <profile>
      <id>local</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.wildfly.plugins</groupId>
              <artifactId>wildfly-maven-plugin</artifactId>
              <version>${wildfly.plugin.version}</version>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <!-- Coverage is opt-in: the pinned JaCoCo agent predates the local JDK. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
