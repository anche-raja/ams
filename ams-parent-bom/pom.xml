<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.ams</groupId>
  <artifactId>ams-parent-bom</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AMS Parent BOM</name>
  <description>Parent POM and dependency BOM for the AMS Internal Asset Management platform.</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <ams.version>1.0.0-SNAPSHOT</ams.version>

    <struts2.version>7.3.0</struts2.version>
    <ognl.version>3.3.5</ognl.version>
    <commons-text.version>1.12.0</commons-text.version>
    <freemarker.version>2.3.33</freemarker.version>

    <!-- Individual BOM versions imported below; no single platform BOM without Spring Boot. -->
    <spring-framework-bom.version>6.2.0</spring-framework-bom.version>
    <spring-security-bom.version>6.3.4</spring-security-bom.version>
    <jackson-bom.version>2.17.2</jackson-bom.version>
    <junit-bom.version>5.10.3</junit-bom.version>
    <slf4j-bom.version>2.0.13</slf4j-bom.version>

    <!-- spring-security-oauth2 is a legacy artifact not covered by spring-security-bom. -->
    <spring-security-oauth2.version>2.5.2.RELEASE</spring-security-oauth2.version>

    <log4j2.version>2.26.0</log4j2.version>

    <!-- Jakarta EE 10 API versions -->
    <jakarta-servlet-api.version>6.0.0</jakarta-servlet-api.version>
    <jakarta-jstl-api.version>3.0.0</jakarta-jstl-api.version>
    <glassfish-jstl.version>3.0.1</glassfish-jstl.version>
    <jakarta-annotation-api.version>2.1.1</jakarta-annotation-api.version>

    <ojdbc8.version>12.2.0.1</ojdbc8.version>

    <commons-lang3.version>3.17.0</commons-lang3.version>
    <commons-lang.version>2.5</commons-lang.version>
    <commons-io.version>2.17.0</commons-io.version>
    <commons-collections4.version>4.5.0</commons-collections4.version>
    <commons-validator.version>1.4.0</commons-validator.version>
    <json-lib.version>2.4</json-lib.version>
    <ezmorph.version>1.0.6</ezmorph.version>

    <h2.version>1.3.176</h2.version>
    <aspectj.version>1.9.22</aspectj.version>
    <mockito.version>5.12.0</mockito.version>

    <jacoco.plugin.version>0.8.11</jacoco.plugin.version>

    <!--
      The packaging plugins are the one place the original pinned versions could not be kept.
      maven-war-plugin 2.6 and maven-ear-plugin 2.8 date from 2015 and fail to load under Maven
      3.9 with an API incompatibility in Plexus, so the build cannot run at all with them. The
      versions below are the closest releases that work with the Maven in use; the packaging they
      produce is the same. The original values are recorded here so the change is visible:
        war.plugin.version = 2.6
        ear.plugin.version = 2.8
      Revert both if this reactor is ever built with a Maven 3.2-era toolchain again.
    -->
    <war.plugin.version>3.4.0</war.plugin.version>
    <ear.plugin.version>3.3.0</ear.plugin.version>
    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <surefire.plugin.version>3.2.5</surefire.plugin.version>
    <failsafe.plugin.version>3.2.5</failsafe.plugin.version>
    <buildnumber.plugin.version>1.3</buildnumber.plugin.version>
    <checkstyle.plugin.version>2.15</checkstyle.plugin.version>
    <puppycrawl.checkstyle.version>5.6</puppycrawl.checkstyle.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ==================== AMS shared modules ==================== -->
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementSharedCommon</artifactId>
        <version>${ams.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementNetworkValidation</artifactId>
        <version>${ams.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementSharedServices</artifactId>
        <version>${ams.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementInternalCommon</artifactId>
        <version>${ams.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementInternalServices</artifactId>
        <version>${ams.version}</version>
      </dependency>
      <dependency>
        <groupId>com.example.ams</groupId>
        <artifactId>AssetManagementInternalWeb</artifactId>
        <version>${ams.version}</version>
        <type>war</type>
      </dependency>

      <!--
        BOM imports. First declaration of a managed version wins, so any project-specific
        override must sit BEFORE these imports. Order: spring-framework, spring-security,
        jackson, junit, slf4j.
      -->
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-framework-bom</artifactId>
        <version>${spring-framework-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-bom</artifactId>
        <version>${spring-security-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${slf4j-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- ==================== Struts 2 ==================== -->
      <dependency>
        <groupId>org.apache.struts</groupId>
        <artifactId>struts2-core</artifactId>
        <version>${struts2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.struts</groupId>
        <artifactId>struts2-json-plugin</artifactId>
        <version>${struts2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.struts</groupId>
        <artifactId>struts2-spring-plugin</artifactId>
        <version>${struts2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.struts</groupId>
        <artifactId>struts2-convention-plugin</artifactId>
        <version>${struts2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.struts</groupId>
        <artifactId>struts2-tiles-plugin</artifactId>
        <version>${struts2.version}</version>
      </dependency>
      <dependency>
        <groupId>ognl</groupId>
        <artifactId>ognl</artifactId>
        <version>${ognl.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-text</artifactId>
        <version>${commons-text.version}</version>
      </dependency>
      <dependency>
        <groupId>org.freemarker</groupId>
        <artifactId>freemarker</artifactId>
        <version>${freemarker.version}</version>
      </dependency>

      <!-- ==================== Spring Security (legacy OAuth2, not in spring-security-bom) ==================== -->
      <dependency>
        <groupId>org.springframework.security.oauth</groupId>
        <artifactId>spring-security-oauth2</artifactId>
        <version>${spring-security-oauth2.version}</version>
      </dependency>

      <!-- ==================== Logging ==================== -->
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-api</artifactId>
        <version>${log4j2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>${log4j2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>${log4j2.version}</version>
      </dependency>

      <!-- ==================== JSON ==================== -->
      <dependency>
        <groupId>net.sf.json-lib</groupId>
        <artifactId>json-lib</artifactId>
        <classifier>jdk15</classifier>
        <version>${json-lib.version}</version>
      </dependency>
      <dependency>
        <groupId>net.sf.ezmorph</groupId>
        <artifactId>ezmorph</artifactId>
        <version>${ezmorph.version}</version>
      </dependency>

      <!-- ==================== Jakarta EE 10 web ==================== -->
      <dependency>
        <groupId>jakarta.servlet</groupId>
        <artifactId>jakarta.servlet-api</artifactId>
        <version>${jakarta-servlet-api.version}</version>
        <scope>provided</scope>
      </dependency>
      <!-- Tomcat 10.1 does not ship JSTL: API + Glassfish implementation bundled at compile scope. -->
      <dependency>
        <groupId>jakarta.servlet.jsp.jstl</groupId>
        <artifactId>jakarta.servlet.jsp.jstl-api</artifactId>
        <version>${jakarta-jstl-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.glassfish.web</groupId>
        <artifactId>jakarta.servlet.jsp.jstl</artifactId>
        <version>${glassfish-jstl.version}</version>
      </dependency>
      <!--
        The JSR-250 security annotations. The Jakarta EE 10 container provides these at runtime, so
        the scope is provided - but @EnableGlobalMethodSecurity(jsr250Enabled = true) needs them on
        the compile and test classpath, or the security configuration cannot be built outside the
        container.
      -->
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>${jakarta-annotation-api.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- ==================== Persistence (JDBC only - no ORM) ==================== -->
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc8</artifactId>
        <version>${ojdbc8.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- ==================== Apache Commons ==================== -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-lang3</artifactId>
        <version>${commons-lang3.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-lang</groupId>
        <artifactId>commons-lang</artifactId>
        <version>${commons-lang.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>${commons-io.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-collections4</artifactId>
        <version>${commons-collections4.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-validator</groupId>
        <artifactId>commons-validator</artifactId>
        <version>${commons-validator.version}</version>
      </dependency>

      <!-- ==================== AOP ==================== -->
      <dependency>
        <groupId>org.aspectj</groupId>
        <artifactId>aspectjtools</artifactId>
        <version>${aspectj.version}</version>
      </dependency>

      <!-- ==================== Test ==================== -->
      <!-- JUnit 5: version supplied by the imported junit-bom, no version here. -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <scope>test</scope>
      </dependency>
      <!-- Mockito 5 (no BOM); mockito-junit-jupiter carries MockitoExtension. -->
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-core</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.mockito</groupId>
        <artifactId>mockito-junit-jupiter</artifactId>
        <version>${mockito.version}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- spring-test version managed by spring-framework-bom, no version here. -->
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-test</artifactId>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every AMS module logs through Log4j2. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.plugin.version}</version>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-war-plugin</artifactId>
          <version>${war.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-ear-plugin</artifactId>
          <version>${ear.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>buildnumber-maven-plugin</artifactId>
          <version>${buildnumber.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${checkstyle.plugin.version}</version>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${puppycrawl.checkstyle.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Coverage is opt-in. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
