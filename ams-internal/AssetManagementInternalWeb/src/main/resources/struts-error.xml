<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <package name="error" namespace="/" extends="AssetManagementInternalWeb">
    <action name="CustomError" class="ErrorAction" method="customError">
      <interceptor-ref name="basicStack"/>
      <result>/WEB-INF/global/customError.jsp</result>
    </action>

    <action name="Unauthorized" class="ErrorAction" method="unauthorized">
      <interceptor-ref name="basicStack"/>
      <result>/WEB-INF/global/unauthorized.jsp</result>
    </action>

    <!-- Answers a grid whose session has gone, in a shape the grid can act on. -->
    <action name="JsonError" class="JsonErrorAction" method="invalidSession">
      <interceptor-ref name="basicStack"/>
      <result type="json">
        <param name="root">model</param>
      </result>
    </action>
  </package>

</struts>
