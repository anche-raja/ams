<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.5//EN"
    "https://struts.apache.org/dtds/struts-6.5.dtd">
<struts>

  <!-- TODO(migration): routing defaults changed in Struts 7. alwaysSelectFullNamespace now
       defaults to true and fallbackToEmptyNamespace to false. These are set to their old values
       below to preserve existing URL resolution; adopt the new defaults deliberately later. -->
  <constant name="struts.mapper.alwaysSelectFullNamespace" value="false"/>
  <constant name="struts.actionConfig.fallbackToEmptyNamespace" value="true"/>

  <!--
    Mounted at the root namespace with no suffix requirement, so both /health and /health.action
    answer. Spring Security permits both without authentication; see WebSecurityConfig.
  -->
  <package name="health" namespace="/" extends="AssetManagementInternalWeb">
    <action name="health" class="HealthAction" method="health">
      <interceptor-ref name="basicStack"/>
      <result name="none" type="httpheader">
        <param name="status">200</param>
      </result>
    </action>
  </package>

</struts>
