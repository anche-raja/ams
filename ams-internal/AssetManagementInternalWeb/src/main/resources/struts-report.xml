<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
    "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>

  <!--
    The order activity report: every customer with their orders counted by state, on screen and as
    a CSV download. Both are reads, so both are GETs; the role check is in the action.
  -->
  <package name="report" namespace="/" extends="AssetManagementInternalWeb">

    <action name="Report" class="ReportAction" method="report">
      <result>/WEB-INF/report/activityReport.jsp</result>
    </action>

    <!-- The stream result sends getCsvStream() as the body and names the file from the action. -->
    <action name="ReportCsv" class="ReportAction" method="exportCsv">
      <result type="stream">
        <param name="contentType">text/csv;charset=UTF-8</param>
        <param name="inputName">csvStream</param>
        <param name="contentDisposition">attachment;filename="${csvFileName}"</param>
        <param name="bufferSize">4096</param>
      </result>
    </action>
  </package>

</struts>
