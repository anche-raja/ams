<?xml version="1.0" encoding="UTF-8"?>
<server description="AMS Internal Asset Management">

  <!--
    Only the features the application actually uses. Liberty starts what is listed and nothing
    else, so keeping this list minimal is both a startup-time and an attack-surface decision.
  -->
  <featureManager>
    <feature>servlet-3.1</feature>
    <feature>jsp-2.3</feature>
    <feature>jdbc-4.1</feature>
    <!-- Required for DataSourceConfig's java:comp/env/jdbc/amsInternalDS lookup. It was absent
         until the first native run: the websphere-liberty "-full-" image ships every feature, so
         the omission was invisible in the container and fatal outside it. -->
    <feature>jndi-1.0</feature>
    <feature>transportSecurity-1.0</feature>
    <feature>ssl-1.0</feature>
  </featureManager>

  <!--
    mpMetrics-1.1 and mpHealth-4.0 used to be listed here and were removed: nothing in the
    application imports org.eclipse.microprofile or carries @Health, @Counted, @Timed or @Gauge, and
    /health is a Struts action (struts-health.xml -> HealthAction), which is what the container
    healthcheck has always actually hit. They were also a feature-resolution hazard - mpHealth-4.0
    is a Jakarta EE 9 feature while servlet-3.1 and jsp-2.3 are Java EE 7.
  -->

  <!--
    Defaults so the server starts on a bare checkout with nothing exported. bootstrap.properties
    still reads ${env.*} first, so a deployment overrides every one of these.
  -->
  <variable name="ams.datasource.url"
            defaultValue="jdbc:h2:${server.config.dir}/data/ams;MVCC=TRUE;LOCK_TIMEOUT=5000;DB_CLOSE_ON_EXIT=FALSE"/>
  <variable name="ams.datasource.class" defaultValue="org.h2.jdbcx.JdbcDataSource"/>
  <variable name="ams.datasource.user" defaultValue="sa"/>
  <variable name="ams.datasource.password" defaultValue=""/>
  <variable name="keystore.password" defaultValue="amsLocalKeystorePw"/>

  <httpEndpoint id="defaultHttpEndpoint"
                host="*"
                httpPort="9081"
                httpsPort="9444">
    <!-- Behind the reverse proxy, so the forwarded headers carry the real client. -->
    <httpOptions removeServerHeader="true"/>
  </httpEndpoint>

  <ssl id="defaultSSLConfig"
       keyStoreRef="defaultKeyStore"
       sslProtocol="TLSv1.2"
       enabledCiphers="TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"/>

  <keyStore id="defaultKeyStore" password="${keystore.password}"/>

  <!--
    The connection pool is the container's, looked up over JNDI by DataSourceConfig. Sizing and
    validation live here rather than in the application so they can be tuned per environment
    without a rebuild.
  -->
  <!--
    Resolved relative to the server directory rather than an absolute container path: the driver is
    put here by liberty-maven-plugin's copyDependencies, from the same Maven coordinates the tests
    resolve, so a native run and a test run use one jar.
  -->
  <library id="AmsJdbcLib">
    <fileset dir="${server.config.dir}/lib" includes="h2*.jar"/>
    <fileset dir="/config/configDropins/lib" includes="ojdbc8*.jar"/>
  </library>

  <dataSource id="amsInternalDS"
              jndiName="jdbc/amsInternalDS"
              transactional="true"
              isolationLevel="TRANSACTION_READ_COMMITTED">
    <jdbcDriver libraryRef="AmsJdbcLib"
                javax.sql.DataSource="${ams.datasource.class}"/>
    <!-- Generic <properties>, not <properties.oracle>: Liberty maps these onto setters on the
         vendor DataSource, and H2's JdbcDataSource has setURL/setUser/setPassword. -->
    <properties URL="${ams.datasource.url}"
                user="${ams.datasource.user}"
                password="${ams.datasource.password}"/>
    <connectionManager id="amsInternalConnMgr"
                       maxPoolSize="10"
                       minPoolSize="5"
                       connectionTimeout="30s"
                       agedTimeout="30m"
                       reapTime="3m"/>
  </dataSource>

  <application id="AssetManagementInternalWeb"
               location="AssetManagementInternalWeb.war"
               name="AssetManagementInternalWeb"
               type="war"
               context-root="AssetManagementInternalWeb"/>

  <!--
    No container-managed security roles are declared. Authentication happens at the reverse proxy
    and authorisation is decided by the application from the iv-groups header, so there is nothing
    for the container to enforce here.
  -->

  <logging traceSpecification="*=info"
           consoleLogLevel="INFO"
           maxFileSize="100"
           maxFiles="10"/>

  <webContainer deferServletLoad="false"
                disableXPoweredBy="true"/>

</server>
