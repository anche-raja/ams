<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:jdbc="http://www.springframework.org/schema/jdbc"
       xmlns:tx="http://www.springframework.org/schema/tx"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd
           http://www.springframework.org/schema/jdbc
           http://www.springframework.org/schema/jdbc/spring-jdbc.xsd
           http://www.springframework.org/schema/tx
           http://www.springframework.org/schema/tx/spring-tx.xsd">

  <!--
    Integration test data source for the internal module.

    The shared tables come from the shared module's test-jar rather than from a second copy of
    the DDL, so the two schemas cannot drift apart. Only the tables the internal module adds are
    defined here.
  -->
  <!--
    Integration test data source.

    An embedded H2 database, built from the same SQL the running application installs - the
    canonical schema under db/schema and db/seed/core in this module's main resources, reached here
    over the ordinary classpath. There used to be a parallel fixture tree under src/test/resources
    that described the same tables; it was the subset, missing both ledger tables and every
    constraint, and it is gone. Tests and the running server now load identical bytes.

    The canonical DDL is Oracle: VARCHAR2(n CHAR), NUMBER, and the DAOs lean on DUAL, SYSTIMESTAMP,
    sequence NEXTVAL, ROWNUM, NVL, GREATEST and TRUNC. H2 1.x happened to accept that subset in its
    regular mode; H2 2.x tightened its parser and rejects the Oracle "CHAR" length qualifier (and
    VARCHAR2/NUMBER) unless Oracle compatibility is requested, so the embedded URL now carries
    MODE=Oracle. That keeps the test schema byte-identical to what Oracle installs - no second,
    H2-only copy of the DDL - and leaves every DAO statement running against the same dialect.

    LOCK_TIMEOUT is not decoration. The scheduling DAOs take row locks with SELECT ... FOR UPDATE,
    and the five-second bound that used to be "WAIT 5" in PL/SQL now lives on the URL. H2 2.x is
    multi-version concurrent by default, so the old MVCC=TRUE setting is gone - it is no longer a
    recognised connection setting and H2 refuses a URL that still carries it.
  -->
  <jdbc:embedded-database id="dataSource" type="H2"
                          database-name="ams;MODE=Oracle;LOCK_TIMEOUT=5000">

    <jdbc:script location="classpath*:db/schema/01_tables/*.sql"/>
    <jdbc:script location="classpath*:db/schema/04_sequences/*.sql"/>
    <jdbc:script location="classpath*:db/schema/05_views/*.sql"/>
    <jdbc:script location="classpath*:db/schema/02_constraints/*.sql"/>
    <jdbc:script location="classpath*:db/schema/03_indexes/*.sql"/>
    <jdbc:script location="classpath*:db/seed/core/*.sql"/>
  </jdbc:embedded-database>

  <bean id="transactionManager"
        class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
    <property name="dataSource" ref="dataSource"/>
  </bean>

  <tx:annotation-driven transaction-manager="transactionManager"/>

</beans>
